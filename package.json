{
  "name": "breeze-plugin-zai-man-hua",
  "version": "0.0.6",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "node --import tsx build/generate-version.ts && pnpm typecheck && node --import tsx build/generate-manifest.ts && cross-env NODE_OPTIONS=\"--import tsx\" rspack build && node --import tsx build/generate-brotli.ts",
    "dev": "pnpm dev:serve",
    "dev:serve": "tsx dev-server.ts"
  },
  "devDependencies": {
    "@rspack/cli": "^2.0.5",
    "@rspack/core": "^2.0.5",
    "@types/node": "^25.9.1",
    "cross-env": "^10.1.0",
    "oxlint": "^1.67.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "breeze-plugin-kit": "^0.3.0",
    "wretch": "^3.0.8"
  }
}
